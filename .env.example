# FamilyChat environment template.
# Copy this file to .env for local/private runs. Never commit .env.
# All values below are placeholders; replace secrets before using real accounts.

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=familychat
TZ=UTC

# -----------------------------------------------------------------------------
# Domains
# -----------------------------------------------------------------------------
FAMILYCHAT_WEB_DOMAIN=web.familychat.local
FAMILYCHAT_API_DOMAIN=api.familychat.local
NEXT_PUBLIC_FAMILY_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_MATRIX_BASE_URL=http://localhost:8080
NEXT_PUBLIC_MATRIX_SERVER_NAME=familychat.local
MATRIX_SERVER_NAME=familychat.local
MATRIX_PUBLIC_BASEURL=http://localhost:8080/
MATRIX_DOMAIN=matrix.familychat.local
LIVEKIT_DOMAIN=livekit.familychat.local

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=change-me-in-real-env

# -----------------------------------------------------------------------------
# Synapse
# -----------------------------------------------------------------------------
SYNAPSE_IMAGE=matrixdotorg/synapse:latest
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=change-me
SYNAPSE_MACAROON_SECRET_KEY=change-me
SYNAPSE_FORM_SECRET=change-me
SYNAPSE_MAX_UPLOAD_SIZE=100M

# -----------------------------------------------------------------------------
# Matrix admin
# -----------------------------------------------------------------------------
# Used later by Family API to call Synapse admin APIs.
# Do not expose this token in frontend code or logs.
MATRIX_HOMESERVER_URL=http://synapse:8008
MATRIX_ADMIN_USER=@admin:familychat.local
MATRIX_ADMIN_ACCESS_TOKEN=change-me-later

# -----------------------------------------------------------------------------
# Reverse proxy
# -----------------------------------------------------------------------------
NGINX_IMAGE=nginx:1.27-alpine
NGINX_HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Family API
# -----------------------------------------------------------------------------
# Family API refuses to start with these placeholder secrets. Generate private
# values in .env before running family-api, for example: openssl rand -hex 32
FAMILY_API_BASE_URL=http://localhost:8000
FAMILY_API_POSTGRES_DB=familychat
FAMILY_API_POSTGRES_USER=familychat
FAMILY_API_POSTGRES_PASSWORD=change-me-in-real-env
FAMILY_API_DATABASE_URL=postgresql+psycopg://familychat:change-me-in-real-env@postgres:5432/familychat
FAMILY_API_ALLOW_SQLITE=false
FAMILY_API_SECRET_KEY=change-me
FAMILY_API_INVITE_PEPPER=change-me
FAMILY_API_ACCESS_TOKEN_MINUTES=43200
FAMILY_API_RATE_LIMIT_WINDOW_SECONDS=60
FAMILY_API_REGISTER_RATE_LIMIT=10
FAMILY_API_LOGIN_RATE_LIMIT=10
FAMILY_API_INVITE_RATE_LIMIT=20
FAMILY_API_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FAMILY_API_RESERVED_MATRIX_LOCALPARTS=admin,administrator,root,support,system,synapse,server,api,bot,moderator

# -----------------------------------------------------------------------------
# LiveKit calls
# -----------------------------------------------------------------------------
LIVEKIT_IMAGE=livekit/livekit-server:latest
LIVEKIT_CALLS_ENABLED=false
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_PORT=7882

# -----------------------------------------------------------------------------
# Web Push placeholders
# -----------------------------------------------------------------------------
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=change-me
WEB_PUSH_VAPID_PRIVATE_KEY=change-me
WEB_PUSH_SUBJECT=mailto:admin@example.invalid
MATRIX_PUSH_APP_ID=familychat.web
MATRIX_PUSH_GATEWAY_URL=http://family-api:8000/api/push/matrix/notify
