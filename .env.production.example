# FamilyChat production deployment template.
# Copy to a private .env.production on the VPS and replace every <change-me...> value.
# Never commit .env.production or real secrets.

COMPOSE_PROJECT_NAME=familychat
TZ=UTC

# -----------------------------------------------------------------------------
# Public domains
# -----------------------------------------------------------------------------
FAMILYCHAT_WEB_DOMAIN=chat.example.invalid
FAMILYCHAT_API_DOMAIN=api.example.invalid
MATRIX_DOMAIN=matrix.example.invalid
LIVEKIT_DOMAIN=livekit.example.invalid
PUBLIC_HTTP_PORT=80

# Browser-exposed frontend config. These are public URLs, not secrets.
NEXT_PUBLIC_FAMILY_API_BASE_URL=https://api.example.invalid
NEXT_PUBLIC_MATRIX_BASE_URL=https://matrix.example.invalid
NEXT_PUBLIC_MATRIX_SERVER_NAME=familychat.example.invalid

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=synapse
POSTGRES_USER=synapse
POSTGRES_PASSWORD=<change-me-private-postgres-password>
FAMILY_API_POSTGRES_DB=familychat
FAMILY_API_POSTGRES_USER=familychat
FAMILY_API_POSTGRES_PASSWORD=<change-me-private-family-api-db-password>

# Keep this URL internal to Compose.
FAMILY_API_DATABASE_URL=postgresql+psycopg://familychat:<change-me-private-family-api-db-password>@postgres:5432/familychat
FAMILY_API_ALLOW_SQLITE=false

# -----------------------------------------------------------------------------
# Synapse
# -----------------------------------------------------------------------------
# Synapse config is static; update private /data/homeserver.yaml with real
# generated secrets and public_baseurl before creating real users.
SYNAPSE_IMAGE=matrixdotorg/synapse:latest
MATRIX_SERVER_NAME=familychat.example.invalid
MATRIX_PUBLIC_BASEURL=https://matrix.example.invalid/
SYNAPSE_REPORT_STATS=no
SYNAPSE_REGISTRATION_SHARED_SECRET=<change-me-private-synapse-registration-secret>
SYNAPSE_MACAROON_SECRET_KEY=<change-me-private-synapse-macaroon-secret>
SYNAPSE_FORM_SECRET=<change-me-private-synapse-form-secret>
SYNAPSE_MAX_UPLOAD_SIZE=100M

# -----------------------------------------------------------------------------
# Family API secrets and access control
# -----------------------------------------------------------------------------
FAMILY_API_SECRET_KEY=<change-me-private-family-api-jwt-secret-at-least-32-chars>
FAMILY_API_INVITE_PEPPER=<change-me-private-family-api-invite-pepper-at-least-32-chars>
FAMILY_API_ACCESS_TOKEN_MINUTES=43200
FAMILY_API_RATE_LIMIT_WINDOW_SECONDS=60
FAMILY_API_REGISTER_RATE_LIMIT=10
FAMILY_API_LOGIN_RATE_LIMIT=10
FAMILY_API_INVITE_RATE_LIMIT=20
FAMILY_API_CORS_ALLOWED_ORIGINS=https://chat.example.invalid
FAMILY_API_RESERVED_MATRIX_LOCALPARTS=admin,administrator,root,support,system,synapse,server,api,bot,moderator

# Server-only Synapse admin integration for Family API. Never expose to frontend.
MATRIX_HOMESERVER_URL=http://synapse:8008
MATRIX_ADMIN_USER=@admin:familychat.example.invalid
MATRIX_ADMIN_ACCESS_TOKEN=<change-me-private-matrix-admin-access-token-at-least-32-chars>

# -----------------------------------------------------------------------------
# LiveKit calls
# -----------------------------------------------------------------------------
LIVEKIT_IMAGE=livekit/livekit-server:latest
LIVEKIT_CALLS_ENABLED=false
LIVEKIT_URL=wss://livekit.example.invalid
LIVEKIT_API_KEY=<change-me-private-livekit-api-key>
LIVEKIT_API_SECRET=<change-me-private-livekit-api-secret-at-least-32-chars>
LIVEKIT_PORT=7880
# Keep RTC ports localhost-bound while calls are disabled. Set to 0.0.0.0 only
# after enabling calls and firewalling the configured RTC ports intentionally.
LIVEKIT_RTC_BIND_IP=127.0.0.1
LIVEKIT_USE_EXTERNAL_IP=true
LIVEKIT_PUBLIC_RTC_TCP_PORT=7881
LIVEKIT_PUBLIC_RTC_UDP_PORT=7882

# -----------------------------------------------------------------------------
# Web Push
# -----------------------------------------------------------------------------
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=<change-me-public-vapid-public-key>
WEB_PUSH_VAPID_PRIVATE_KEY=<change-me-private-vapid-private-key>
WEB_PUSH_SUBJECT=mailto:admin@example.invalid
MATRIX_PUSH_APP_ID=familychat.web
# Synapse calls this from inside Compose; keep it internal unless your deployment
# intentionally routes container egress through the public HTTPS domain.
MATRIX_PUSH_GATEWAY_URL=http://family-api:8000/api/push/matrix/notify

# -----------------------------------------------------------------------------
# Images
# -----------------------------------------------------------------------------
NGINX_IMAGE=nginx:1.27-alpine
